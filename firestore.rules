rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@.*'))
      );
    }

    // Test connection document for initial boot verification
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Assets collection
    match /assets/{assetId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(assetId) &&
        incoming().code is string && incoming().code.size() <= 50 &&
        incoming().name is string && incoming().name.size() <= 150 &&
        incoming().locationCode is string && incoming().locationCode.size() <= 20;
      allow update: if isSignedIn() && isValidId(assetId) &&
        incoming().code is string && incoming().name is string;
      allow delete: if isSignedIn() && isValidId(assetId);
    }

    // Rotations collection
    match /rotations/{rotationId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(rotationId) &&
        incoming().assetCode is string && incoming().toLocationCode is string;
      allow update: if isSignedIn() && isValidId(rotationId);
      allow delete: if isSignedIn() && isValidId(rotationId);
    }

    // Locations collection
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(locationId);
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(userId);
    }

    // Period locks collection
    match /periodLocks/{lockId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(lockId);
    }

    // Audit logs collection (append-only)
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isValidId(logId) && incoming().timestamp is string;
      allow update, delete: if false;
    }

    // Backups snapshot collection
    match /backups/{backupId} {
      allow read, write: if isValidId(backupId);
    }

    // System configuration and sync markers
    match /system/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
